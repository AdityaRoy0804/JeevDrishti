# Copy to .env and edit.
API_KEY=demo-key
DATA_DIR=./data

DETECTOR=megadetector            # megadetector | none (use whole image)
DETECTOR_MODEL=MDV6-mit-yolov9-c # verify against your installed PytorchWildlife version
DETECTION_CONFIDENCE=0.2

EMBEDDER=megadescriptor          # megadescriptor | dinov2 | dummy (no weights, for smoke tests)
# EMBEDDER_MODEL=hf-hub:BVRA/MegaDescriptor-L-384   (optional override; B-224 is lighter)
EMBEDDER_MODEL=hf-hub:BVRA/MegaDescriptor-B-224
DEVICE=auto                      # auto | cuda | cpu

# PLACEHOLDERS - calibrate with: python -m scripts.evaluate
MATCH_THRESHOLD=0.80
REVIEW_THRESHOLD=0.65
MIN_MARGIN=0.05
TOP_K=5
